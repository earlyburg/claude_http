<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="claude_http">
  <description>PHP CodeSniffer configuration for claude_http module</description>

  <!-- Include the Drupal and DrupalPractice standards -->
  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>

  <!-- Scan these files and directories -->
  <file>.</file>

  <!-- Exclude vendor and other directories -->
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/node_modules/*</exclude-pattern>

  <!-- Only check PHP files -->
  <arg name="extensions" value="php,module,inc,install,test,profile,theme"/>

  <!-- Show progress -->
  <arg value="p"/>

  <!-- Use colors in output -->
  <arg name="colors"/>

  <!-- Show sniff codes in all reports -->
  <arg value="s"/>
</ruleset>